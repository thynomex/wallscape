{
  "name": "wallscape-win",
  "version": "0.2.0",
  "description": "Native Windows wallpaper manager for images and videos.",
  "type": "module",
  "scripts": {
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "setup:mpv": "powershell -ExecutionPolicy Bypass -File scripts/setup-libmpv.ps1",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
}
